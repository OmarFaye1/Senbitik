{
  "name": "senbitik",
  "version": "1.0.0",
  "type": "module",
  "description": "Senbitik - Plateforme e-commerce de produits locaux et du terroir",
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"cyan,green\" \"node backend/server.js\" \"vite\"",
    "start:prod": "NODE_ENV=production node backend/server.js",
    "dev": "vite",
    "server": "node backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "npm install --prefix backend",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "react-router-dom": "^6.22.3",
    "sonner": "^1.4.41",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0"
  }
}
