# ─── Base de données MySQL ──────────────────────────────────────────────────
# En local (MySQL Community Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=senbitik_db

# Sur Railway, ces variables sont automatiquement fournies par le plugin MySQL :
# MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE
# (vous n'avez pas besoin de les définir manuellement sur Railway)

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Sécurité admin ──────────────────────────────────────────────────────────
# Changez cette valeur en production !
ADMIN_SECRET=senbitik-admin-2024

# ─── URL du frontend ─────────────────────────────────────────────────────────
# En développement : http://localhost:3000
# En production sur Railway : laissez vide (même domaine, CORS géré automatiquement)
CLIENT_URL=http://localhost:3000
